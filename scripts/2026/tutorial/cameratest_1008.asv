imaqreset;

info = imaqhwinfo('gentl');

if isempty(info.DeviceIDs)
    error(['GenTLカメラが見つかりません。' ...
        ' pylon Viewerを閉じ、USB接続を確認してください。']);
end

vid = videoinput('gentl', 1, 'Mono12');

%%
img = getsnapshot(vid);

figure
imagesc(img)
axis image
% colormap gray
colorbar

fprintf("min  = %g\n", min(img(:)));
fprintf("max  = %g\n", max(img(:)));
fprintf("mean = %g\n", mean(double(img(:))));

%%
src = getselectedsource(vid);

src.ExposureAuto = "Off";
src.ExposureTime = 80000;

src.GainAuto = "off";
src.Gain = 5;

%%
img = getsnapshot(vid);

fig = figure;
ax = axes(fig);

hImage = image(ax, img);
hImage.CDataMapping = 'scaled';

axis(ax, 'image');
colorb(ax, 'turbo');

% clim(ax, [0 4095]);

preview(vid, hImage);